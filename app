function toggleTabs(hide){const n=$('main-tabs');if(!n)return;n.classList.toggle('nav-hidden',Boolean(hide));document.body.classList.toggle('tabs-collapsed',Boolean(hide))}
function save(){try{localStorage.setItem(KEY,JSON.stringify({years:S.years,year:S.year}))}catch(e){}}
function agg(){const r=Array(12).fill(0),g=Array(12).fill(0),i=Array(12).fill(0);Y().tx.forEach(t=>{(t.t==='renda'?r:t.t==='desp'?g:i)[+t.d.slice(5,7)-1]+=t.v});return{r,g,i}}
const kpi=(c,l,v)=>`<div class="kpi-card ${c}"><div class="kpi-label">${l}</div><div class="kpi-value">${brl(v)}</div></div>`;
function setYear(y){S.year=y;mon=now.getFullYear()===y?now.getMonth():0;day=isNow()?now.getDate():1;toggleTabs(false);save();render()}
function setMon(m){mon=m;day=isNow()?now.getDate():1;render()}
function setDay(d){day=d;render();toggleTabs(true)}
function goMes(i){setMon(i);openTab('meses',document.querySelectorAll('.tab-btn')[1])}
function openTab(id,btn){document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));$(id).classList.add('active');if(btn)btn.classList.add('active');toggleTabs(false);if(id==='dashboard')render()}
let ch1,ch2;
function charts(a){if(typeof Chart==='undefined')return;if(ch1)ch1.destroy();if(ch2)ch2.destroy();const o={responsive:true,maintainAspectRatio:false};ch1=new Chart($('c1'),{type:'bar',data:{labels:MN,datasets:[{label:'Renda',data:a.r,backgroundColor:'#14232F',borderRadius:6},{label:'Gastos',data:a.g,backgroundColor:'#F76B55',borderRadius:6},{label:'Investido',data:a.i,backgroundColor:'#8B6BE8',borderRadius:6}]},options:o});const by={};Y().tx.filter(t=>t.t==='desp').forEach(t=>by[t.c]=(by[t.c]||0)+t.v);const k=Object.keys(by);ch2=new Chart($('c2'),{type:'doughnut',data:{labels:k.length?k:['Sem despesas ainda'],datasets:[{data:k.length?k.map(x=>by[x]):[1],backgroundColor:k.length?PAL:['#EAE3D8']}]},options:o})}
function rDash(){const a=agg(),sum=x=>x.reduce((p,q)=>p+q,0),R=sum(a.r),G=sum(a.g),I=sum(a.i);$('yr-t').textContent=S.year;$('kpis').innerHTML=kpi('dark','Renda do ano',R)+kpi('alert','Gastos do ano',G)+kpi('','Investido',I)+kpi('gold','Saldo do ano',R-G-I);$('dm').innerHTML=MF.map((m,i)=>{const s=a.r[i]-a.g[i]-a.i[i];return`<tr><td><strong>${m}</strong></td><td class="num">${brl(a.r[i])}</td><td class="num">${brl(a.g[i])}</td><td class="num">${brl(a.i[i])}</td><td class="num" style="color:${s>=0?'#8B6BE8':'#F76B55'}"><strong>${brl(s)}</strong></td><td class="center"><button class="badge badge-green" style="border:0;cursor:pointer" onclick="goMes(${i})">Abrir →</button></td></tr>`}).join('');charts(a)}
function rows(l){if(!l.length)return'<p class="empty">Nenhum lançamento ainda ✦</p>';return`<table><thead><tr><th>Dia</th><th>Tipo</th><th>Categoria</th><th>Descrição</th><th class="num">Valor</th><th></th></tr></thead><tbody>${l.slice().sort((a,b)=>a.d<b.d?-1:1).map(t=>`<tr><td><input class="mini" type="number" min="1" max="31" value="${+t.d.slice(8)}" onchange="edTxF('${t.id}','d',this.value)"></td><td>${sel(t.id,'t',Object.keys(T).map(k=>[k,T[k].n]),t.t)}</td><td>${sel(t.id,'c',[...new Set([...T[t.t].c,t.c])].map(c=>[c,c]),t.c)}</td><td data-editable="true" contenteditable="true" onblur="edTx('${t.id}','s',this.innerText)">${esc(t.s)}</td><td class="num" data-editable="true" contenteditable="true" onblur="edTx('${t.id}','v',this.innerText)">${brl(t.v)}</td><td class="center"><button class="del" onclick="delTx('${t.id}')">✕</button></td></tr>`).join('')}</tbody></table>`}
function rMonth(){const a=agg(),r=a.r[mon],g=a.g[mon],i=a.i[mon];$('mp').innerHTML=MN.map((m,x)=>`<button class="month-pill ${x===mon?'active':''}" onclick="setMon(${x})">${m}</button>`).join('');$('mk').innerHTML=kpi('dark','Renda',r)+kpi('alert','Gastos',g)+kpi('','Investido',i)+kpi('gold','Saldo do mês',r-g-i);$('cal-t').textContent=`📅 ${MF[mon]} de ${S.year}`;const first=new Date(S.year,mon,1).getDay(),n=new Date(S.year,mon+1,0).getDate(),list=Y().tx.filter(t=>+t.d.slice(5,7)-1===mon);let h=['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'].map(d=>`<div class="cal-h">${d}</div>`).join('')+'<div></div>'.repeat(first);for(let d=1;d<=n;d++){const ds=list.filter(t=>+t.d.slice(8)===d),has=k=>ds.some(t=>t.t===k);h+=`<button class="cal-d ${d===day?'sel':''} ${isNow()&&now.getDate()===d?'today':''}" onclick="setDay(${d})"><b>${d}</b><span class="dots">${has('renda')?'<i class="dr"></i>':''}${has('desp')?'<i class="dg"></i>':''}${has('inv')?'<i class="di"></i>':''}</span></button>`}$('cal').innerHTML=h;const dstr=`${S.year}-${pad(mon+1)}-${pad(day)}`;$('dayp').innerHTML=`<h3>✦ ${pad(day)}/${pad(mon+1)}/${S.year}</h3><div class="form-grid"><div class="form-field"><label>Tipo</label><select id="f-t" onchange="fillCats()">${Object.keys(T).map(k=>`<option value="${k}">${T[k].e} ${T[k].n}</option>`).join('')}</select></div><div class="form-field"><label>Categoria</label><select id="f-c"></select></div><div class="form-field"><label>Descrição</label><input id="f-s" maxlength="60" placeholder="Ex.: mercado"></div><div class="form-field"><label>Valor (R$)</label><input id="f-v" type="number" step="0.01" min="0" inputmode="decimal"></div><button class="btn-botanic" onclick="addTx()">+ Adicionar</button></div><div class="table-wrap">${rows(list.filter(t=>t.d===dstr))}</div>`;fillCats();$('mt').innerHTML=list.length?rows(list):'<p class="empty">Nenhum lançamento neste mês. Toque num dia do calendário para começar ✦</p>'}
function fillCats(){$('f-c').innerHTML=T[$('f-t').value].c.map(c=>`<option>${c}</option>`).join('')}
function addTx(){const v=parseFloat($('f-v').value);if(!(v>0)){$('f-v').focus();return}Y().tx.push({id:'t'+Date.now().toString(36)+Math.random().toString(36).slice(2,6),d:`${S.year}-${pad(mon+1)}-${pad(day)}`,t:$('f-t').value,c:$('f-c').value,s:$('f-s').value.trim().slice(0,60)||'Lançamento',v});save();render();toggleTabs(true);if($('f-s'))$('f-s').value='';if($('f-v')){$('f-v').value='';$('f-v').focus()}}
const sel=(id,f,o,cur)=>`<select class="mini" onchange="edTxF('${id}','${f}',this.value)">${o.map(x=>`<option value="${esc(x[0])}" ${x[0]===cur?'selected':''}>${esc(x[1])}</option>`).join('')}</select>`;
function edTxF(id,f,v){const t=Y().tx.find(x=>x.id===id);if(!t)return;if(f==='t'){t.t=v;if(!T[v].c.includes(t.c))t.c=T[v].c[0]}else if(f==='c')t.c=v;else{const m=+t.d.slice(5,7)-1,n=new Date(S.year,m+1,0).getDate();t.d=t.d.slice(0,8)+pad(Math.min(n,Math.max(1,parseInt(v,10)||1)))}save();render();toggleTabs(true)}
function edTx(id,f,txt){const t=Y().tx.find(x=>x.id===id);if(!t)return;if(f==='v'){const v=num(txt);if(v!==null&&v>=0)t.v=v}else t.s=txt.trim().slice(0,60)||'Lançamento';save();render();toggleTabs(true)}
function delTx(id){Y().tx=Y().tx.filter(x=>x.id!==id);save();render()}
function rList(k){const c=L[k],a=Y()[k],form=`<div class="form-grid">${c.cols.map(f=>`<div class="form-field"><label>${f[1]}</label><input id="n-${k}-${f[0]}" ${f[2]==='t'?'maxlength="40"':'type="number" step="0.01" inputmode="decimal"'}></div>`).join('')}<button class="btn-botanic" onclick="addL('${k}')">+ Adicionar</button></div>`,body=a.length?`<div class="table-wrap"><table><thead><tr>${c.cols.map(f=>`<th>${f[1]}</th>`).join('')}${k==='goals'?'<th>Progresso</th>':''}<th></th></tr></thead><tbody>${a.map((r,i)=>`<tr>${c.cols.map(f=>`<td class="${f[2]==='t'?'':'num'}" data-editable="true" contenteditable="true" onblur="edL('${k}',${i},'${f[0]}','${f[2]}',this.innerText)">${f[2]==='n'?brl(r[f[0]]):esc(r[f[0]]??'')}</td>`).join('')}${k==='goals'?`<td><div class="progress"><i style="width:${r.alvo>0?Math.min(100,r.atual/r.alvo*100):0}%"></i></div></td>`:''}<td class="center"><button class="del" onclick="delL('${k}',${i})">✕</button></td></tr>`).join('')}</tbody></table></div>`:'<p class="empty">Nada por aqui ainda. Adicione o primeiro item acima ✦</p>';$('list-'+k).innerHTML=`<div class="card">${form}${body}</div>`}
function addL(k){const r={};for(const f of L[k].cols){const v=$(`n-${k}-${f[0]}`).value.trim();r[f[0]]=f[2]==='t'?v.slice(0,40):(parseFloat(v)||0)}if(!r.nome)return;Y()[k].push(r);save();render()}
function edL(k,i,f,tp,txt){const r=Y()[k][i];if(!r)return;if(tp==='t')r[f]=txt.trim().slice(0,40);else{const v=tp==='i'?parseInt(txt,10):num(txt);if(v!==null&&!isNaN(v))r[f]=v}save();render()}
function delL(k,i){Y()[k].splice(i,1);save();render()}
function exp(){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify({years:S.years},null,2)],{type:'application/json'}));a.download='flora-backup.json';a.click()}
function imp(el){const f=el.files[0];if(!f)return;const rd=new FileReader();rd.onload=()=>{try{const x=JSON.parse(rd.result);if(x&&x.years){YRS.forEach(y=>{if(x.years[y])S.years[y]=Object.assign({tx:[],cards:[],goals:[]},x.years[y])});save();render()}}catch(e){}};rd.readAsText(f);el.value=''}
function render(){$('years').innerHTML=YRS.map(y=>`<button class="year-btn ${y===S.year?'active':''}" onclick="setYear(${y})">📁 ${y}</button>`).join('');rDash();rMonth();rList('cards');rList('goals')}
render();
const AK='flora_auth_v1',te=new TextEncoder(),hx=b=>[...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join(''),getAuth=()=>{try{return JSON.parse(localStorage.getItem(AK)||'null')}catch(e){return null}};
async function hashPw(pw,salt){if(window.crypto&&crypto.subtle){const k=await crypto.subtle.importKey('raw',te.encode(pw),'PBKDF2',false,['deriveBits']);return hx(await crypto.subtle.deriveBits({name:'PBKDF2',salt:te.encode(salt),iterations:150000,hash:'SHA-256'},k,256))}let h=7;for(const c of salt+pw)h=(Math.imul(31,h)+c.charCodeAt(0))|0;return'f'+h}
function saveName(){const u=$('ac-name').value.trim().slice(0,30),a=getAuth(),m=$('ac-msg');if(!a)return;if(!u){m.textContent='Digite um nome.';return}a.u=u;try{localStorage.setItem(AK,JSON.stringify(a))}catch(e){}$('who').textContent='Olá, '+u;m.textContent='Nome salvo ✦'}
async function changePw(){const a=getAuth(),m=$('ac-msg'),o=$('ac-old').value,n=$('ac-new').value;if(!a)return;if(await hashPw(o,a.salt)!==a.h){m.textContent='Senha atual incorreta.';return}if(n.length<6){m.textContent='A nova senha precisa ter pelo menos 6 caracteres.';return}if(n!==$('ac-new2').value){m.textContent='As senhas novas não conferem.';return}a.salt=Array.from({length:16},()=>Math.floor(Math.random()*256).toString(16)).join('');a.h=await hashPw(n,a.salt);try{localStorage.setItem(AK,JSON.stringify(a))}catch(e){}$(['ac-old','ac-new','ac-new2'].forEach(i=>$(i).value=''));m.textContent='Senha alterada ✦'}
function lgMode(){const a=getAuth();lgForgot.s=0;$('lg-title').textContent=a?`Olá, ${a.u} ✦`:'Criar seu acesso ✦';$('lg-sub').textContent=a?'Digite sua senha para entrar.':'Defina um nome e uma senha para proteger o FLORA neste aparelho.';$('lg-name').style.display=$('lg-pw2').style.display=a?'none':'block';$('lg-btn').textContent=a?'Entrar':'Criar acesso';$('lg-forgot').style.display=a?'inline':'none';$('lg-forgot').textContent='Esqueci minha senha';$('lg-msg').textContent='';$('lg-pw').value=$('lg-pw2').value=''}
async function lgGo(){const a=getAuth(),pw=$('lg-pw').value,m=$('lg-msg');m.textContent='';if(!a){const u=$('lg-name').value.trim().slice(0,30);if(!u){m.textContent='Digite seu nome.';return}if(pw.length<6){m.textContent='A senha precisa ter pelo menos 6 caracteres.';return}if(pw!==$('lg-pw2').value){m.textContent='As senhas não conferem.';return}const salt=Array.from({length:16},()=>Math.floor(Math.random()*256).toString(16)).join('');try{localStorage.setItem(AK,JSON.stringify({u,salt,h:await hashPw(pw,salt)}))}catch(e){m.textContent='Não foi possível salvar o acesso neste navegador.';return}}else if(await hashPw(pw,a.salt)!==a.h){m.textContent='Senha incorreta.';return}unlock($('lg-keep').checked)}
function unlock(keep){try{if(keep!==undefined)(keep?localStorage:sessionStorage).setItem('flora_ok','1');sessionStorage.setItem('flora_ok','1')}catch(e){}document.body.classList.remove('locked');$('who').textContent='Olá, '+getAuth().u;$('ac-name').value=getAuth().u;$('lg-pw').value=$('lg-pw2').value='';render()}
function logout(){try{sessionStorage.removeItem('flora_ok');localStorage.removeItem('flora_ok')}catch(e){}document.body.classList.add('locked');lgMode()}
function lgForgot(){if(!lgForgot.s){lgForgot.s=1;$('lg-msg').textContent='Redefinir apaga os dados salvos neste aparelho. Toque de novo para confirmar.';$('lg-forgot').textContent='Sim, apagar e redefinir';return}try{[AK,KEY,'flora_ok'].forEach(k=>localStorage.removeItem(k));sessionStorage.removeItem('flora_ok')}catch(e){}location.reload()}
lgMode();try{if(getAuth()&&(sessionStorage.getItem('flora_ok')==='1'||localStorage.getItem('flora_ok')==='1'))unlock()}catch(e){}
</script></body></html>
